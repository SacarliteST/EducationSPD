{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "education-spd",
    "SkillCatalogTopic": "learning.skill-catalog",
    "EpisodeFinalizedTopic": "learning.episode-finalized",
    "MaxRetryAttempts": 5,
    "InitialRetryDelayMilliseconds": 500
  },
  "Inbox": {
    "BatchSize": 100,
    "PendingCatalogRetryIntervalSeconds": 30
  },
  "Recalculation": {
    "BatchSize": 100,
    "PollIntervalSeconds": 5
  },
  "Model": {
    "InitialMasteryProbability": 0.20,
    "LearnProbability": 0.10,
    "ValidationRuleGuessProbability": 0.10,
    "ValidationRuleSlipProbability": 0.10,
    "TaskTagGuessProbability": 0.25,
    "TaskTagSlipProbability": 0.25,
    "AhpMatrix": [
      [1.0, 3.0, 5.0, 7.0],
      [0.3333333333, 1.0, 3.0, 4.0],
      [0.2, 0.3333333333, 1.0, 2.0],
      [0.1428571429, 0.25, 0.5, 1.0]
    ]
  },
  "ServiceAuthentication": {
    "ServiceKey": ""
  }
}
